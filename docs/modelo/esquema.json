: "cod_tse", "tipo": "VARCHAR(5)", "nulo": false, "gerada": null, "padrao": null}, {"nome": "zona", "tipo": "SMALLINT", "nulo": false, "gerada": null, "padrao": null}, {"nome": "turno", "tipo": "SMALLINT", "nulo": false, "gerada": null, "padrao": null}, {"nome": "cargo", "tipo": "VARCHAR(40)", "nulo": false, "gerada": null, "padrao": null}, {"nome": "votos_nominais", "tipo": "INTEGER", "nulo": false, "gerada": null, "padrao": "0"}, {"nome": "votos_legenda", "tipo": "INTEGER", "nulo": false, "gerada": null, "padrao": "0"}], "pk": ["cod_eleicao", "id_partido", "cod_tse", "zona", "turno", "cargo"], "uq": null, "fks": [{"colunas": ["cod_eleicao"], "ref": "eleicao", "cascata": false}, {"colunas": ["id_partido"], "ref": "partido", "cascata": false}, {"colunas": ["cod_tse"], "ref": "municipio", "cascata": false}], "checks": [], "linhas": 276694, "bytes": 37765120}}, "visoes": {"vw_candidatura": " SELECT c.sq_candidato,\n    c.titulo_eleitoral,\n    c.cod_eleicao,\n    c.id_partido,\n    c.ue,\n    c.cargo,\n    c.coligacao,\n    c.escolaridade,\n    c.idade_posse,\n    c.reeleicao,\n    c.situacao_final,\n    e.ano,\n    e.abrangencia,\n    c.situacao_final::text = ANY (ARRAY['ELEITO'::character varying, 'ELEITO POR QP'::character varying, 'ELEITO POR MÉDIA'::character varying]::text[]) AS eleito\n   FROM candidatura c\n     JOIN eleicao e ON e.cod_eleicao = c.cod_eleicao;", "vw_patrimonio": " SELECT c.sq_candidato,\n    COALESCE(sum(b.valor), 0::numeric) AS patrimonio_total\n   FROM candidatura c\n     LEFT JOIN bem b ON b.sq_candidato = c.sq_candidato\n  GROUP BY c.sq_candidato;", "vw_qt_mandatos": " SELECT p.titulo_eleitoral,\n    count(v.sq_candidato) FILTER (WHERE v.eleito) AS qt_mandatos\n   FROM politico p\n     LEFT JOIN vw_candidatura v ON v.titulo_eleitoral::text = p.titulo_eleitoral::text\n  GROUP BY p.titulo_eleitoral;", "vw_ideologia_partido": " SELECT pa.id_partido,\n    a.ano,\n    esp.nota AS nota_especialistas,\n    esp.herdada AS nota_herdada,\n    col.nota AS nota_coligacoes\n   FROM partido pa\n     CROSS JOIN generate_series(1998, 2024, 2) a(ano)\n     LEFT JOIN LATERAL ( SELECT i.nota,\n            i.id_partido <> pa.id_partido AS herdada\n           FROM ideologia_partido i\n             JOIN partido pi ON pi.id_partido = i.id_partido\n          WHERE i.id_partido = pa.id_partido OR pi.numero = pa.numero AND (pa.sigla::text = ANY (ARRAY['PMDB'::character varying, 'PFL'::character varying, 'PPB'::character varying, 'PRN'::character varying, 'PSN'::character varying, 'PSDC'::character varying, 'PT DO B'::character varying, 'PTN'::character varying, 'PEN'::character varying]::text[]))\n          ORDER BY (i.id_partido <> pa.id_partido), (abs(i.ano_survey - a.ano)), i.ano_survey DESC\n         LIMIT 1) esp ON true\n     LEFT JOIN LATERAL ( SELECT round(avg(ic.nota), 2) AS nota\n           FROM ideologia_coligacao ic\n          WHERE ic.id_partido = pa.id_partido AND abs(ic.ano - a.ano) <= 2) col ON true;"}, "indices": [{"nome": "idx_candidatura_eleicao", "tabela": "candidatura", "def": "CREATE INDEX idx_candidatura_eleicao ON public.candidatura USING btree (cod_eleicao, cargo, ue)"}, {"nome": "idx_candidatura_politico", "tabela": "candidatura", "def": "CREATE INDEX idx_candidatura_politico ON public.candidatura USING btree (titulo_eleitoral)"}, {"nome": "idx_receita_candidato", "tabela": "receita", "def": "CREATE INDEX idx_receita_candidato ON public.receita USING btree (sq_candidato)"}, {"nome": "idx_despesa_candidato", "tabela": "despesa", "def": "CREATE INDEX idx_despesa_candidato ON public.despesa USING btree (sq_candidato)"}, {"nome": "idx_votos_cand_mun", "tabela": "votos_cand", "def": "CREATE INDEX idx_votos_cand_mun ON public.votos_cand USING btree (cod_tse)"}, {"nome": "idx_votos_part_mun", "tabela": "votos_part", "def": "CREATE INDEX idx_votos_part_mun ON public.votos_part USING btree (cod_tse, cod_eleicao)"}], "tamanho": "1688 MB"}